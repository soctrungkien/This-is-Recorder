    <string name="help_title">Guide and limitations</string>
    <string name="help_quick_settings_title">Quick Settings tile</string>
    <string name="help_quick_settings_body">Open the Quick Settings panel, tap Edit, then drag “Screen recorder” into the panel. Tap the tile to start recording. While recording, tap it again to stop without opening the app. The first start still opens the app so Android can show the capture consent prompt.</string>
    <string name="help_audio_title">Phone audio</string>
    <string name="help_audio_body">Phone audio uses Android\'s playback capture API. Apps can exclude their audio, and calls, DRM-protected content, and some games may be silent. Root mode does not support phone audio; use Standard mode for that.</string>
    <string name="help_root_title">Root mode</string>
    <string name="help_root_body">Root mode runs screenrecord as root and does not need MediaProjection consent. Videos are recorded in 180-second segments and joined when you stop. Only microphone audio is supported. Secure windows remain black.</string>
    <string name="help_storage_title">Where videos are saved</string>
    <string name="help_storage_body">Videos are saved to %1$s. Change the folder in Settings → Storage; all folders used by this app are listed on the Videos page.</string>

