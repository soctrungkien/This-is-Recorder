    <string name="root_mode_dialog_title">Bật chế độ Root?</string>
    <string name="root_mode_dialog_message">Chế độ Root dùng screenrecord, không cần hộp thoại cấp quyền MediaProjection. Chế độ này chỉ ghi micrô và tự chia video dài thành các đoạn 3 phút. Không hỗ trợ âm thanh của điện thoại.</string>
